---
import MainHead from "./MainHead.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  active: "dashboard" | "documents" | "staff" | "students" | "tickets" | "announcements" | "analytics" | "accounts";
  pageTitle: string;
  eyebrow?: string;
}

const { title, description = "", active, pageTitle, eyebrow } = Astro.props;

const userName = Astro.locals.userName ?? "Admin";
const collegeName = Astro.locals.collegeName ?? "";
const userRole = Astro.locals.userRole ?? "admin";
const userInitial = userName.charAt(0).toUpperCase();

const nav = [
  {
    id: "dashboard",
    label: "Dashboard",
    href: "/app/admin",
    icon: `<rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/>`,
  },
  {
    id: "documents",
    label: "Documents",
    href: "/app/admin/documents",
    icon: `<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="13" y2="17"/>`,
  },
  {
    id: "staff",
    label: "Staff Directory",
    href: "/app/admin/staff",
    icon: `<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>`,
  },
  ...(userRole === "admin"
    ? [
        {
          id: "accounts",
          label: "Staff Accounts",
          href: "/app/admin/accounts",
          icon: `<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/><circle cx="12" cy="12" r="3"/>`,
        },
      ]
    : []),
  {
    id: "students",
    label: "Students",
    href: "/app/admin/students",
    icon: `<path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/>`,
  },
  {
    id: "tickets",
    label: "Tickets",
    href: "/app/admin/tickets",
    icon: `<path d="M4 5a2 2 0 0 0-2 2v3a2 2 0 0 1 0 4v3a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-3a2 2 0 0 1 0-4V7a2 2 0 0 0-2-2z"/><line x1="12" y1="7" x2="12" y2="17" stroke-dasharray="2 3"/>`,
  },
  {
    id: "announcements",
    label: "Announcements",
    href: "/app/admin/announcements",
    icon: `<path d="m3 11 18-5v12L3 14v-3z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/>`,
  },
  {
    id: "analytics",
    label: "Analytics",
    href: "/app/admin/analytics",
    icon: `<path d="M3 3v18h18"/><rect x="7" y="12" width="3" height="5"/><rect x="12" y="8" width="3" height="9"/><rect x="17" y="5" width="3" height="12"/>`,
  },
];
---

<html lang="en">
  <MainHead title={title} description={description} />
  <body class="font-grotesk">
    <div class="flex h-screen overflow-hidden bg-[#f6f7f9]">

      <!-- ═══ SIDEBAR (dark rail) ═══ -->
      <aside
        id="admin-sidebar"
        class="w-[248px] shrink-0 flex flex-col bg-dark z-30 transition-transform duration-300"
      >
        <!-- Logo -->
        <div class="px-5 py-5">
          <a href="/" class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-[10px] bg-green flex items-center justify-center shrink-0">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#191a23" stroke-width="2.5"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            </div>
            <span class="text-base font-medium text-white leading-none">
              Desk<span class="text-green">Mate</span>
            </span>
          </a>
          <p class="eyebrow mt-3 pl-0.5">{userRole === 'admin' ? 'Admin Console' : 'Staff Portal'}</p>
        </div>

        <!-- Nav -->
        <nav class="flex-1 px-3 py-2 flex flex-col gap-1 app-scroll overflow-y-auto">
          {nav.map((item) => (
            <a
              href={item.href}
              class={`nav-item ${active === item.id ? "nav-item-active" : ""}`}
            >
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" set:html={item.icon} />
              {item.label}
            </a>
          ))}
        </nav>

        <!-- Back to chat -->
        <div class="px-3 pb-2">
          <a href="/app/chat" class="nav-item">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            Back to Chat
          </a>
        </div>

        <!-- User -->
        <div class="px-4 py-4 border-t border-[#ffffff]/[0.08]">
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-green flex items-center justify-center shrink-0">
              <span class="text-dark text-xs font-semibold">{userInitial}</span>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-xs font-medium text-white truncate">{userName}</p>
              <p class="text-[10px] text-[#9aa0a6] truncate">{collegeName ? `${collegeName} • ${userRole === 'admin' ? 'Admin' : 'Staff'}` : (userRole === 'admin' ? 'Administrator' : 'Staff Member')}</p>
            </div>
            <form method="post" action="/api/auth/logout">
              <button type="submit" class="p-1.5 rounded-lg text-[#9aa0a6] hover:text-white hover:bg-[#ffffff]/[0.06] transition-colors" title="Sign out">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
              </button>
            </form>
          </div>
        </div>
      </aside>

      <!-- Mobile overlay -->
      <div id="admin-overlay" class="fixed inset-0 bg-[#000000]/[0.4] z-20 hidden lg:hidden"></div>

      <!-- ═══ MAIN ═══ -->
      <div class="flex-1 flex flex-col min-w-0">

        <!-- Topbar -->
        <header class="shrink-0 bg-[#ffffff]/[0.85] backdrop-blur-md border-b border-[#e8eaed] sticky top-0 z-10">
          <div class="flex items-center justify-between gap-4 px-5 lg:px-8 h-16">
            <div class="flex items-center gap-3 min-w-0">
              <button id="admin-menu-btn" class="lg:hidden p-1.5 -ml-1 rounded-lg text-[#555] hover:bg-[#f0f1f3] transition-colors">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12h18M3 6h18M3 18h18"/></svg>
              </button>
              <div class="min-w-0">
                {eyebrow && <p class="eyebrow leading-none mb-1">{eyebrow}</p>}
                <h1 class="text-lg font-medium text-dark leading-none truncate">{pageTitle}</h1>
              </div>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <a
                id="admin-bell"
                href="/app/admin/tickets"
                title="Open tickets"
                class="relative p-2 rounded-lg text-[#6b6f76] hover:text-dark hover:bg-[#f0f1f3] transition-colors"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                <span id="admin-bell-badge" class="hidden absolute -top-1 -right-1 min-w-[17px] h-[17px] px-1 rounded-full bg-red-500 text-white text-[10px] font-semibold flex items-center justify-center leading-none"></span>
              </a>
              <slot name="action" />
            </div>
          </div>
        </header>

        <!-- Content -->
        <main class="flex-1 overflow-y-auto app-scroll">
          <div class="max-w-[1120px] mx-auto px-5 lg:px-8 py-7 lg:py-9">
            <slot />
          </div>
        </main>
      </div>
    </div>

    <style>
      @media (max-width: 1023px) {
        #admin-sidebar {
          position: fixed;
          top: 0;
          left: 0;
          height: 100%;
          transform: translateX(-100%);
        }
        #admin-sidebar.open { transform: translateX(0); }
      }
    </style>

    <script is:inline>
      (function () {
        var btn = document.getElementById("admin-menu-btn");
        var sidebar = document.getElementById("admin-sidebar");
        var overlay = document.getElementById("admin-overlay");
        function open() {
          sidebar.classList.add("open");
          overlay.classList.remove("hidden");
        }
        function close() {
          sidebar.classList.remove("open");
          overlay.classList.add("hidden");
        }
        if (btn) btn.addEventListener("click", open);
        if (overlay) overlay.addEventListener("click", close);
      })();

      // ─── Ticket notification bell (polls every 60s) ───
      (function () {
        var bell = document.getElementById("admin-bell");
        var badge = document.getElementById("admin-bell-badge");
        if (!bell || !badge) return;

        function refresh() {
          fetch("/api/admin/tickets")
            .then(function (r) { return r.ok ? r.json() : null; })
            .then(function (data) {
              if (!data || !data.ok) return;
              var unresolved = (data.open_count || 0) + (data.in_progress_count || 0);
              if (unresolved > 0) {
                badge.textContent = unresolved > 99 ? "99+" : String(unresolved);
                badge.classList.remove("hidden");
              } else {
                badge.classList.add("hidden");
              }
            })
            .catch(function () { /* bell stays as-is */ });
        }

        refresh();
        setInterval(refresh, 60000);
      })();
    </script>
  </body>
</html>
