---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { createSupabaseServerClient } from "../../../lib/supabase";

const { request, cookies, locals } = Astro;

if (!locals.user || (locals.userRole !== "admin" && locals.userRole !== "staff")) {
  return Astro.redirect("/login");
}

const supabase = createSupabaseServerClient(request, cookies);
const { data: staff } = await supabase
  .from("staff_members")
  .select("id, name, role, department, email, phone, whatsapp, office_location, office_hours, languages, query_categories, urgency_level, status, created_at")
  .eq("college_name", locals.collegeName)
  .order("created_at", { ascending: false });

const members = staff ?? [];

const queryCategories = [
  "admissions", "enrollment", "fee", "accounts", "payments", "examinations",
  "results", "academic", "placements", "internships", "career", "hostel",
  "student affairs", "welfare", "computer science", "technical",
  "sports", "library", "transport", "scholarship", "maintenance", "security",
  "counseling", "health", "medical", "canteen", "lab", "workshop",
];

// Shared icon paths for contact rows
const icons = {
  email: `<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>`,
  phone: `<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>`,
  whatsapp: `<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>`,
  location: `<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>`,
  hours: `<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>`,
};
---

<AdminLayout
  title="Staff Directory — DeskMate Admin"
  description="Manage the staff directory for DeskMate routing."
  active="staff"
  pageTitle="Staff"
  eyebrow="Routing directory"
>
  <button slot="action" id="open-staff-modal" class="btn-app-primary">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg>
    Add Staff Member
  </button>

  {locals.userRole === "admin" && (
    <div class="bg-[#f0f4ff] border border-[#d0e0fd] rounded-[16px] p-4 mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-full bg-blue-100 text-blue-700 flex items-center justify-center shrink-0">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
          </svg>
        </div>
        <div>
          <p class="text-xs font-semibold text-blue-900">Looking to deactivate staff login accounts?</p>
          <p class="text-[11px] text-blue-700">This directory is for chatbot routing. To deactivate staff member login privileges, visit Staff Accounts.</p>
        </div>
      </div>
      <a href="/app/admin/accounts" class="px-3.5 py-1.5 rounded-[10px] bg-dark text-white text-xs font-medium shrink-0 hover:bg-black transition-colors self-start sm:self-auto">
        Go to Staff Accounts &rarr;
      </a>
    </div>
  )}

  {members.length > 0 ? (
    <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-4" id="staff-grid">
      {members.map((member) => (
        <div class="app-card p-5 flex flex-col hover:border-[#d5d8dd] transition-colors" data-staff-id={member.id}>
          <!-- Header -->
          <div class="flex items-start gap-3">
            <div class="w-11 h-11 rounded-full bg-dark flex items-center justify-center shrink-0">
              <span class="text-green text-sm font-semibold">{member.name.charAt(0).toUpperCase()}</span>
            </div>
            <div class="flex-1 min-w-0">
              <h3 class="text-[15px] font-medium text-dark leading-snug truncate">{member.name}</h3>
              <p class="text-xs text-[#6b6f76] truncate">{member.role}</p>
              <p class="text-xs text-[#9aa0a6] truncate">{member.department}</p>
            </div>
            <button data-action="delete-staff" title="Remove" class="shrink-0 p-1.5 -mt-0.5 -mr-1 rounded-lg text-[#c4c9cf] hover:text-red-500 hover:bg-red-50 transition-colors">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
            </button>
          </div>

          <!-- Status + urgency -->
          <div class="flex items-center gap-1.5 flex-wrap mt-3">
            {member.status === "active" ? (
              <span class="chip chip-lime"><span class="w-1.5 h-1.5 rounded-full bg-[#191a23]/[0.7]"></span>Active</span>
            ) : (
              <span class="chip chip-neutral">Inactive</span>
            )}
            {member.urgency_level === "emergency" && <span class="chip chip-danger">Emergency</span>}
            {member.urgency_level === "urgent" && <span class="chip chip-amber">Urgent</span>}
          </div>

          <!-- Contact -->
          <div class="mt-4 flex flex-col gap-2 text-sm text-[#555]">
            {member.email && (
              <div class="flex items-center gap-2.5 min-w-0">
                <svg class="shrink-0 text-[#9aa0a6]" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" set:html={icons.email} />
                <span class="truncate">{member.email}</span>
              </div>
            )}
            {member.phone && (
              <div class="flex items-center gap-2.5 min-w-0">
                <svg class="shrink-0 text-[#9aa0a6]" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" set:html={icons.phone} />
                <span class="truncate">{member.phone}</span>
              </div>
            )}
            {member.whatsapp && (
              <div class="flex items-center gap-2.5 min-w-0">
                <svg class="shrink-0 text-[#9aa0a6]" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" set:html={icons.whatsapp} />
                <span class="truncate">{member.whatsapp}</span>
              </div>
            )}
            {member.office_location && (
              <div class="flex items-center gap-2.5 min-w-0">
                <svg class="shrink-0 text-[#9aa0a6]" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" set:html={icons.location} />
                <span class="truncate">{member.office_location}</span>
              </div>
            )}
            {member.office_hours && (
              <div class="flex items-center gap-2.5 min-w-0">
                <svg class="shrink-0 text-[#9aa0a6]" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" set:html={icons.hours} />
                <span class="truncate">{member.office_hours}</span>
              </div>
            )}
          </div>

          <!-- Languages -->
          {member.languages && member.languages.length > 0 && (
            <div class="mt-4">
              <p class="eyebrow mb-1.5">Languages</p>
              <div class="flex flex-wrap gap-1.5">
                {member.languages.map((lang: string) => (
                  <span class="chip chip-neutral capitalize">{lang}</span>
                ))}
              </div>
            </div>
          )}

          <!-- Handles -->
          {member.query_categories && member.query_categories.length > 0 && (
            <div class="mt-3 pt-4 border-t border-[#f0f1f3]">
              <p class="eyebrow mb-1.5">Handles</p>
              <div class="flex flex-wrap gap-1.5">
                {member.query_categories.map((cat: string) => (
                  <span class="chip chip-neutral capitalize">{cat}</span>
                ))}
              </div>
            </div>
          )}
        </div>
      ))}
    </div>
  ) : (
    <div id="staff-grid" class="app-card px-5 py-16 text-center">
      <div class="w-12 h-12 rounded-[16px] bg-[#f0f1f3] flex items-center justify-center mx-auto mb-3">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#9aa0a6" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
      </div>
      <p class="text-sm font-medium text-dark">No staff members yet</p>
      <p class="text-xs text-[#9aa0a6] mt-1">Click <strong class="text-dark font-medium">Add Staff Member</strong> to enable smart routing.</p>
    </div>
  )}
</AdminLayout>

<!-- Add Staff Modal -->
<div id="staff-modal" class="fixed inset-0 bg-[#000000]/[0.5] backdrop-blur-sm z-[100] hidden items-center justify-center p-4">
  <div class="bg-white rounded-[20px] shadow-[0_24px_60px_rgba(0,0,0,0.25)] border border-[#e8eaed] max-w-lg w-full max-h-[90vh] overflow-y-auto app-scroll">
    <div class="flex justify-between items-center px-7 pt-6 pb-5 border-b border-[#e8eaed] sticky top-0 bg-white z-10">
      <div>
        <p class="eyebrow">New contact</p>
        <h2 class="text-lg font-medium text-dark mt-1">Add Staff Member</h2>
      </div>
      <button id="close-staff-modal" class="p-1.5 rounded-lg text-[#9aa0a6] hover:text-dark hover:bg-[#f0f1f3] transition-colors">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>

    <form id="staff-form" class="flex flex-col gap-4 px-7 py-6">
      <div id="staff-error" class="hidden text-sm text-red-600 bg-red-50 border border-red-200 rounded-[12px] px-4 py-3"></div>

      <div>
        <label class="block text-xs font-medium text-dark mb-1.5">Full Name</label>
        <input id="staff-name" type="text" placeholder="e.g. Dr. Ramesh Kumar" class="app-input" />
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-medium text-dark mb-1.5">Role</label>
          <input id="staff-role" type="text" placeholder="e.g. Fee Officer" class="app-input" />
        </div>
        <div>
          <label class="block text-xs font-medium text-dark mb-1.5">Department</label>
          <input id="staff-dept" type="text" placeholder="e.g. Finance" class="app-input" />
        </div>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-medium text-dark mb-1.5">Email <span class="font-normal text-[#aab0b6]">(optional)</span></label>
          <input id="staff-email" type="email" placeholder="email@college.edu.in" class="app-input" />
        </div>
        <div>
          <label class="block text-xs font-medium text-dark mb-1.5">Phone <span class="font-normal text-[#aab0b6]">(optional)</span></label>
          <input id="staff-phone" type="text" placeholder="+91-40-00000000" class="app-input" />
        </div>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-medium text-dark mb-1.5">WhatsApp <span class="font-normal text-[#aab0b6]">(optional)</span></label>
          <input id="staff-whatsapp" type="text" placeholder="+91-40-00000000" class="app-input" />
        </div>
        <div>
          <label class="block text-xs font-medium text-dark mb-1.5">Office Hours <span class="font-normal text-[#aab0b6]">(optional)</span></label>
          <input id="staff-hours" type="text" placeholder="Mon-Fri 9AM-5PM" class="app-input" />
        </div>
      </div>
      <div>
        <label class="block text-xs font-medium text-dark mb-1.5">Office Location <span class="font-normal text-[#aab0b6]">(optional)</span></label>
        <input id="staff-location" type="text" placeholder="e.g. Admin Block, Room 104" class="app-input" />
      </div>

      <div>
        <label class="block text-xs font-medium text-dark mb-1.5">Languages Spoken</label>
        <div class="grid grid-cols-3 gap-2 p-3.5 bg-[#f8f9fb] border border-[#e8eaed] rounded-[12px]">
          <label class="flex items-center gap-2 text-sm text-[#555]">
            <input type="checkbox" name="languages" value="english" checked class="w-4 h-4 rounded border-[#ccc] accent-dark" />
            <span>English</span>
          </label>
          <label class="flex items-center gap-2 text-sm text-[#555]">
            <input type="checkbox" name="languages" value="hindi" class="w-4 h-4 rounded border-[#ccc] accent-dark" />
            <span>Hindi</span>
          </label>
          <label class="flex items-center gap-2 text-sm text-[#555]">
            <input type="checkbox" name="languages" value="telugu" class="w-4 h-4 rounded border-[#ccc] accent-dark" />
            <span>Telugu</span>
          </label>
        </div>
      </div>

      <div>
        <label class="block text-xs font-medium text-dark mb-1.5">Urgency Level</label>
        <select id="staff-urgency" class="app-input">
          <option value="normal">Normal Support</option>
          <option value="urgent">Urgent Issues</option>
          <option value="emergency">Emergency Contact</option>
        </select>
      </div>

      <div>
        <label class="block text-xs font-medium text-dark mb-1.5">Query Categories <span class="font-normal text-[#aab0b6]">(select all that apply)</span></label>
        <div class="grid grid-cols-2 gap-2 p-3.5 bg-[#f8f9fb] border border-[#e8eaed] rounded-[12px] max-h-40 overflow-y-auto app-scroll">
          {queryCategories.map((category: string) => (
            <label class="flex items-center gap-2 text-sm text-[#555]">
              <input type="checkbox" name="categories" value={category} class="w-4 h-4 rounded border-[#ccc] accent-dark" />
              <span class="capitalize">{category}</span>
            </label>
          ))}
        </div>
      </div>

      <button type="button" id="submit-staff-btn" class="btn-app-primary w-full py-3 mt-1">
        Add Staff Member
      </button>
    </form>
  </div>
</div>

<script is:inline>
  // ─── Modal helpers ───
  function openStaffModal() {
    var m = document.getElementById("staff-modal");
    m.classList.remove("hidden"); m.classList.add("flex");
  }
  function closeStaffModal() {
    var m = document.getElementById("staff-modal");
    m.classList.add("hidden"); m.classList.remove("flex");
    document.getElementById("staff-form").reset();
    document.getElementById("staff-error").classList.add("hidden");
  }
  document.getElementById("open-staff-modal").addEventListener("click", openStaffModal);
  document.getElementById("close-staff-modal").addEventListener("click", closeStaffModal);
  document.getElementById("staff-modal").addEventListener("click", function (e) {
    if (e.target === this) closeStaffModal();
  });

  // ─── Submit ───
  document.getElementById("submit-staff-btn").addEventListener("click", async function () {
    var btn = this;
    var name = document.getElementById("staff-name").value.trim();
    var role = document.getElementById("staff-role").value.trim();
    var dept = document.getElementById("staff-dept").value.trim();
    var email = document.getElementById("staff-email").value.trim();
    var phone = document.getElementById("staff-phone").value.trim();
    var whatsapp = document.getElementById("staff-whatsapp").value.trim();
    var office_location = document.getElementById("staff-location").value.trim();
    var office_hours = document.getElementById("staff-hours").value.trim();
    var urgency_level = document.getElementById("staff-urgency").value;
    var errEl = document.getElementById("staff-error");

    var selectedCategories = Array.from(document.querySelectorAll('input[name="categories"]:checked')).map(function (c) { return c.value; });
    var selectedLanguages = Array.from(document.querySelectorAll('input[name="languages"]:checked')).map(function (c) { return c.value; });

    if (!name || !role || !dept) {
      errEl.textContent = "Name, role, and department are required.";
      errEl.classList.remove("hidden");
      return;
    }
    if (selectedCategories.length === 0) {
      errEl.textContent = "Please select at least one query category.";
      errEl.classList.remove("hidden");
      return;
    }
    if (selectedLanguages.length === 0) {
      errEl.textContent = "Please select at least one language.";
      errEl.classList.remove("hidden");
      return;
    }

    btn.disabled = true;
    btn.textContent = "Adding…";

    try {
      var res = await fetch("/api/admin/staff", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          name: name, role: role, department: dept, email: email, phone: phone,
          whatsapp: whatsapp, office_location: office_location, office_hours: office_hours,
          query_categories: selectedCategories, languages: selectedLanguages,
          urgency_level: urgency_level, status: "active",
        }),
      });
      var data = await res.json();
      if (data.ok) { closeStaffModal(); window.location.reload(); }
      else { errEl.textContent = data.error || "Failed to add."; errEl.classList.remove("hidden"); }
    } catch (e) {
      errEl.textContent = "Network error. Please try again.";
      errEl.classList.remove("hidden");
    }
    btn.disabled = false;
    btn.textContent = "Add Staff Member";
  });

  // ─── Remove ───
  document.addEventListener("click", async function (e) {
    var btn = e.target.closest('[data-action="delete-staff"]');
    if (!btn) return;
    var wrapper = btn.closest("[data-staff-id]");
    if (!wrapper) return;
    if (!confirm("Remove this staff member?")) return;
    btn.disabled = true;
    try {
      var res = await fetch("/api/admin/staff/" + wrapper.dataset.staffId, { method: "DELETE" });
      var data = await res.json();
      if (data.ok) { wrapper.remove(); }
      else { alert("Delete failed: " + (data.error || "unknown error")); btn.disabled = false; }
    } catch (e) { alert("Network error."); btn.disabled = false; }
  });
</script>
