---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { createSupabaseServerClient } from "../../../lib/supabase";

const { request, cookies, locals } = Astro;

if (!locals.user || (locals.userRole !== "admin" && locals.userRole !== "staff")) {
  return Astro.redirect("/login");
}

const supabase = createSupabaseServerClient(request, cookies);
const { data: announcements } = await supabase
  .from("announcements")
  .select("id, title, body, category, pinned, expires_at, created_by_name, created_at, notify_students")
  .eq("college_name", locals.collegeName)
  .order("pinned", { ascending: false })
  .order("created_at", { ascending: false });

const rows = announcements ?? [];
const now = Date.now();

const categories = ["General", "Academic", "Examinations", "Fee", "Placements", "Hostel", "Events", "Holiday"];
---

<AdminLayout
  title="Announcements — DeskMate Admin"
  description="Post notices your students and the assistant can see."
  active="announcements"
  pageTitle="Announcements"
  eyebrow="Notices"
>
  <button slot="action" id="open-ann-modal" class="btn-app-primary">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg>
    New Announcement
  </button>

  {rows.length > 0 ? (
    <div class="flex flex-col gap-3" id="ann-list">
      {rows.map((a) => {
        const expired = a.expires_at && new Date(a.expires_at).getTime() < now;
        return (
          <div class="app-card p-5" data-ann-id={a.id}>
            <div class="flex items-start justify-between gap-4">
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                  <h3 class="text-[15px] font-medium text-dark leading-snug">{a.title}</h3>
                  {a.pinned && <span class="chip chip-lime">Pinned</span>}
                  {a.category && <span class="chip chip-neutral">{a.category}</span>}
                  {a.notify_students && !expired && <span class="chip chip-amber">Notifies students</span>}
                  {expired && <span class="chip chip-danger">Expired</span>}
                </div>
                <p class="text-sm text-[#555] mt-2 leading-relaxed whitespace-pre-line">{a.body}</p>
                <div class="flex items-center gap-3 mt-3 text-xs text-[#9aa0a6] flex-wrap">
                  {a.created_by_name && <span class="font-medium text-[#6b6f76]">{a.created_by_name}</span>}
                  <span>
                    {new Date(a.created_at).toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric" })}
                  </span>
                  {a.expires_at && (
                    <span>
                      Expires {new Date(a.expires_at).toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric" })}
                    </span>
                  )}
                </div>
              </div>
              <button data-action="delete-ann" title="Delete" class="shrink-0 p-1.5 -mt-0.5 -mr-1 rounded-lg text-[#c4c9cf] hover:text-red-500 hover:bg-red-50 transition-colors">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
              </button>
            </div>
          </div>
        );
      })}
    </div>
  ) : (
    <div id="ann-list" class="app-card px-5 py-16 text-center">
      <div class="w-12 h-12 rounded-[16px] bg-[#f0f1f3] flex items-center justify-center mx-auto mb-3">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#9aa0a6" stroke-width="2"><path d="m3 11 18-5v12L3 14v-3z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/></svg>
      </div>
      <p class="text-sm font-medium text-dark">No announcements yet</p>
      <p class="text-xs text-[#9aa0a6] mt-1">Post a notice — the assistant will share it with students who ask.</p>
    </div>
  )}
</AdminLayout>

<!-- New Announcement Modal -->
<div id="ann-modal" class="fixed inset-0 bg-[#000000]/[0.5] backdrop-blur-sm z-[100] hidden items-center justify-center p-4">
  <div class="bg-white rounded-[20px] shadow-[0_24px_60px_rgba(0,0,0,0.25)] border border-[#e8eaed] max-w-lg w-full max-h-[90vh] overflow-y-auto app-scroll">
    <div class="flex justify-between items-center px-7 pt-6 pb-5 border-b border-[#e8eaed] sticky top-0 bg-white z-10">
      <div>
        <p class="eyebrow">New notice</p>
        <h2 class="text-lg font-medium text-dark mt-1">New Announcement</h2>
      </div>
      <button id="close-ann-modal" class="p-1.5 rounded-lg text-[#9aa0a6] hover:text-dark hover:bg-[#f0f1f3] transition-colors">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>

    <form id="ann-form" class="flex flex-col gap-4 px-7 py-6">
      <div id="ann-error" class="hidden text-sm text-red-600 bg-red-50 border border-red-200 rounded-[12px] px-4 py-3"></div>

      <div>
        <label class="block text-xs font-medium text-dark mb-1.5">Title</label>
        <input id="ann-title" type="text" placeholder="e.g. Semester exams start Aug 12" class="app-input" />
      </div>
      <div>
        <label class="block text-xs font-medium text-dark mb-1.5">Body</label>
        <textarea id="ann-body" rows="4" placeholder="Write the full notice…" class="app-input resize-none"></textarea>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-medium text-dark mb-1.5">Category</label>
          <select id="ann-category" class="app-input">
            {categories.map((c) => <option value={c}>{c}</option>)}
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-dark mb-1.5">Expires <span class="font-normal text-[#aab0b6]">(optional)</span></label>
          <input id="ann-expires" type="date" class="app-input" />
        </div>
      </div>
      <label class="flex items-center gap-2 text-sm text-[#555]">
        <input id="ann-pinned" type="checkbox" class="w-4 h-4 rounded border-[#ccc] accent-dark" />
        <span>Pin to top</span>
      </label>
      <label class="flex items-center gap-2 text-sm text-[#555]">
        <input id="ann-notify" type="checkbox" class="w-4 h-4 rounded border-[#ccc] accent-dark" checked />
        <span>Notify students <span class="text-[#9aa0a6]">(shows an unread badge in their chat)</span></span>
      </label>

      <button type="button" id="submit-ann-btn" class="btn-app-primary w-full py-3 mt-1">
        Post Announcement
      </button>
    </form>
  </div>
</div>

<script is:inline>
  // ─── Modal helpers ───
  function openAnnModal() {
    var m = document.getElementById("ann-modal");
    m.classList.remove("hidden"); m.classList.add("flex");
  }
  function closeAnnModal() {
    var m = document.getElementById("ann-modal");
    m.classList.add("hidden"); m.classList.remove("flex");
    document.getElementById("ann-form").reset();
    document.getElementById("ann-error").classList.add("hidden");
  }
  document.getElementById("open-ann-modal").addEventListener("click", openAnnModal);
  document.getElementById("close-ann-modal").addEventListener("click", closeAnnModal);
  document.getElementById("ann-modal").addEventListener("click", function (e) {
    if (e.target === this) closeAnnModal();
  });

  // ─── Submit ───
  document.getElementById("submit-ann-btn").addEventListener("click", async function () {
    var btn = this;
    var title = document.getElementById("ann-title").value.trim();
    var body = document.getElementById("ann-body").value.trim();
    var category = document.getElementById("ann-category").value;
    var expires = document.getElementById("ann-expires").value;
    var pinned = document.getElementById("ann-pinned").checked;
    var notify = document.getElementById("ann-notify").checked;
    var errEl = document.getElementById("ann-error");

    if (!title || !body) {
      errEl.textContent = "Title and body are required.";
      errEl.classList.remove("hidden");
      return;
    }

    btn.disabled = true;
    btn.textContent = "Posting…";

    try {
      var res = await fetch("/api/admin/announcements", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          title: title, body: body, category: category,
          expires_at: expires || null, pinned: pinned,
          notify_students: notify,
        }),
      });
      var data = await res.json();
      if (data.ok) { closeAnnModal(); window.location.reload(); }
      else { errEl.textContent = data.error || "Failed to post."; errEl.classList.remove("hidden"); }
    } catch (e) {
      errEl.textContent = "Network error. Please try again.";
      errEl.classList.remove("hidden");
    }
    btn.disabled = false;
    btn.textContent = "Post Announcement";
  });

  // ─── Delete ───
  document.addEventListener("click", async function (e) {
    var btn = e.target.closest('[data-action="delete-ann"]');
    if (!btn) return;
    var wrapper = btn.closest("[data-ann-id]");
    if (!wrapper) return;
    if (!confirm("Delete this announcement?")) return;
    btn.disabled = true;
    try {
      var res = await fetch("/api/admin/announcements/" + wrapper.dataset.annId, { method: "DELETE" });
      var data = await res.json();
      if (data.ok) { wrapper.remove(); }
      else { alert("Delete failed: " + (data.error || "unknown error")); btn.disabled = false; }
    } catch (e) { alert("Network error."); btn.disabled = false; }
  });
</script>
