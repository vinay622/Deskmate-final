---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { createSupabaseServerClient } from "../../../lib/supabase";

const { request, cookies, locals } = Astro;

// Strict admin-only guard: staff cannot access the accounts management page
if (!locals.user || locals.userRole !== "admin") {
  return Astro.redirect("/app/admin");
}

const supabase = createSupabaseServerClient(request, cookies);

// Query all staff and admin accounts for this college
const { data: accountsData } = await supabase
  .from("profiles")
  .select("id, full_name, email, role, is_active, created_at, department")
  .eq("college_name", locals.collegeName)
  .in("role", ["admin", "staff"])
  .order("role", { ascending: true }) // 'admin' alphabetically before 'staff'
  .order("created_at", { ascending: false });

const accounts = accountsData ?? [];
const currentUserId = locals.user?.id;
const staffAccounts = accounts.filter((a) => a.id !== currentUserId);
const activeCount = staffAccounts.filter((a) => a.is_active !== false).length;
const deactivatedCount = staffAccounts.filter((a) => a.is_active === false).length;

const fmtDate = (d: string) =>
  new Date(d).toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric" });
---

<AdminLayout
  title="Staff Accounts — DeskMate Admin"
  description="Manage college staff member accounts and deactivate personnel who have left."
  active="accounts"
  pageTitle="Staff Accounts"
  eyebrow="Access Management"
>
  <!-- Summary Stats -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-8">
    <div class="app-card p-4">
      <p class="text-xs text-[#9aa0a6] font-medium">Total Staff Members</p>
      <p class="text-2xl font-medium text-dark mt-1">{staffAccounts.length}</p>
    </div>
    <div class="app-card p-4 border-emerald-200 bg-emerald-50/40">
      <p class="text-xs text-emerald-800 font-medium">Active Staff</p>
      <p class="text-2xl font-medium text-emerald-900 mt-1">{activeCount}</p>
    </div>
    <div class="app-card p-4 border-red-200 bg-red-50/40">
      <p class="text-xs text-red-800 font-medium">Deactivated Staff</p>
      <p class="text-2xl font-medium text-red-900 mt-1">{deactivatedCount}</p>
    </div>
    <div class="app-card p-4 border-purple-200 bg-purple-50/40">
      <p class="text-xs text-purple-800 font-medium">College Admin</p>
      <p class="text-2xl font-medium text-purple-900 mt-1">1 (You)</p>
    </div>
  </div>

  <!-- Security Explanation Banner -->
  <div class="bg-[#f0f4ff] border border-[#d0e0fd] rounded-[16px] p-4 mb-6 flex items-start gap-3">
    <div class="w-8 h-8 rounded-full bg-blue-100 text-blue-700 flex items-center justify-center shrink-0 mt-0.5">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
      </svg>
    </div>
    <div>
      <h3 class="text-xs font-semibold text-blue-900 uppercase tracking-wider">Staff Account Management</h3>
      <p class="text-xs text-blue-800 mt-0.5 leading-relaxed">
        Staff sign up using your college's staff access code to help manage documents, announcements, and tickets.
        When a staff member leaves the institution, you can deactivate their account below to immediately revoke their login privileges and dashboard access.
      </p>
    </div>
  </div>

  <!-- Search & Filter Controls -->
  <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 mb-4">
    <div class="relative flex-1 max-w-sm">
      <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-[#aaa]">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
        </svg>
      </span>
      <input
        type="text"
        id="search-input"
        placeholder="Search staff by name or email..."
        class="w-full pl-9 pr-4 py-2 border border-[#e0e0e0] rounded-[12px] text-xs text-dark placeholder-[#aaa] outline-none focus:border-dark transition-colors bg-white"
        oninput="filterAccounts()"
      />
    </div>

    <div class="flex items-center gap-2">
      <button
        onclick="setStatusFilter('all')"
        id="filter-all"
        class="filter-btn active-filter px-3 py-1.5 rounded-[10px] text-xs font-medium transition-colors"
      >
        All ({accounts.length})
      </button>
      <button
        onclick="setStatusFilter('active')"
        id="filter-active"
        class="filter-btn px-3 py-1.5 rounded-[10px] text-xs font-medium text-[#777] hover:text-dark transition-colors"
      >
        Active ({activeCount + 1})
      </button>
      <button
        onclick="setStatusFilter('deactivated')"
        id="filter-deactivated"
        class="filter-btn px-3 py-1.5 rounded-[10px] text-xs font-medium text-[#777] hover:text-dark transition-colors"
      >
        Deactivated ({deactivatedCount})
      </button>
    </div>
  </div>

  <!-- Accounts Table -->
  <div class="app-card overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse" id="accounts-table">
        <thead>
          <tr class="border-b border-[#e8eaed] bg-[#f9fafb] text-[11px] font-semibold text-[#888] uppercase tracking-wider">
            <th class="py-3 px-4">Member</th>
            <th class="py-3 px-4">Role</th>
            <th class="py-3 px-4">Status</th>
            <th class="py-3 px-4">Joined On</th>
            <th class="py-3 px-4 text-right">Access Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#f0f1f3] text-xs text-dark" id="accounts-tbody">
          {accounts.map((user) => {
            const isSelf = user.id === currentUserId;
            const isActive = user.is_active !== false;
            const initials = (user.full_name || "Staff")
              .split(" ")
              .map((n: string) => n[0])
              .slice(0, 2)
              .join("")
              .toUpperCase();

            return (
              <tr
                class="hover:bg-[#fbfcfd] transition-colors account-row"
                data-name={(user.full_name || "").toLowerCase()}
                data-email={(user.email || "").toLowerCase()}
                data-status={isActive ? "active" : "deactivated"}
                data-role={isSelf ? "admin" : "staff"}
                id={`row-${user.id}`}
              >
                <!-- Member info -->
                <td class="py-3.5 px-4">
                  <div class="flex items-center gap-3">
                    <div class={`w-8 h-8 rounded-full flex items-center justify-center font-semibold text-[11px] shrink-0 ${isSelf ? 'bg-purple-100 text-purple-700' : 'bg-gray-100 text-[#444]'}`}>
                      {initials}
                    </div>
                    <div>
                      <p class="font-medium text-dark leading-tight">
                        {user.full_name || "Unnamed Staff"}
                        {isSelf && <span class="ml-1.5 text-[10px] text-purple-700 bg-purple-100 px-1.5 py-0.5 rounded font-medium">You</span>}
                      </p>
                      <p class="text-[11px] text-[#888] mt-0.5">{user.email || "No email"}</p>
                    </div>
                  </div>
                </td>

                <!-- Role -->
                <td class="py-3.5 px-4">
                  {isSelf ? (
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-medium bg-purple-100 text-purple-800 border border-purple-200">
                      <span class="w-1.5 h-1.5 rounded-full bg-purple-600"></span>
                      College Admin
                    </span>
                  ) : (
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-medium bg-blue-50 text-blue-700 border border-blue-200">
                      <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
                      Staff Member
                    </span>
                  )}
                </td>

                <!-- Status -->
                <td class="py-3.5 px-4">
                  <span
                    id={`status-badge-${user.id}`}
                    class={`inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-medium ${
                      isActive
                        ? "bg-emerald-50 text-emerald-700 border border-emerald-200"
                        : "bg-red-50 text-red-700 border border-red-200"
                    }`}
                  >
                    <span class={`w-1.5 h-1.5 rounded-full ${isActive ? "bg-emerald-500" : "bg-red-500"}`}></span>
                    <span id={`status-text-${user.id}`}>{isActive ? "Active" : "Deactivated"}</span>
                  </span>
                </td>

                <!-- Joined On -->
                <td class="py-3.5 px-4 text-[#777] text-[11px]">
                  {user.created_at ? fmtDate(user.created_at) : "—"}
                </td>

                <!-- Actions -->
                <td class="py-3.5 px-4 text-right">
                  {isSelf ? (
                    <span class="text-[11px] text-[#aaa] font-medium px-2.5 py-1 bg-gray-50 border border-gray-200 rounded-lg inline-block">
                      Current Admin (You)
                    </span>
                  ) : (
                    <button
                      id={`action-btn-${user.id}`}
                      onclick={`toggleAccountStatus('${user.id}', ${isActive ? 'false' : 'true'}, '${encodeURIComponent(user.full_name || 'this staff member')}')`}
                      class={`px-3 py-1.5 rounded-[10px] text-xs font-semibold cursor-pointer transition-all ${
                        isActive
                          ? "text-red-700 bg-red-50 hover:bg-red-100 border border-red-200"
                          : "text-emerald-700 bg-emerald-50 hover:bg-emerald-100 border border-emerald-200"
                      }`}
                    >
                      {isActive ? "Deactivate" : "Reactivate"}
                    </button>
                  )}
                </td>
              </tr>
            );
          })}

          {accounts.length === 0 && (
            <tr>
              <td colspan="5" class="py-8 text-center text-[#888]">
                No staff accounts found for {locals.collegeName}.
              </td>
            </tr>
          )}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Toast Notification -->
  <div
    id="toast"
    class="fixed bottom-6 right-6 z-50 transform translate-y-12 opacity-0 transition-all duration-300 pointer-events-none px-4 py-3 rounded-[14px] shadow-lg text-xs font-medium flex items-center gap-2"
  ></div>
</AdminLayout>

<style>
  .filter-btn {
    background-color: transparent;
  }
  .active-filter {
    background-color: #191a23;
    color: #ffffff !important;
  }
</style>

<script is:inline>
  var currentFilter = 'all';

  function setStatusFilter(status) {
    currentFilter = status;
    document.querySelectorAll('.filter-btn').forEach(function(b) {
      b.classList.remove('active-filter');
      b.classList.add('text-[#777]');
    });
    var target = document.getElementById('filter-' + status);
    if (target) {
      target.classList.add('active-filter');
      target.classList.remove('text-[#777]');
    }
    filterAccounts();
  }

  function filterAccounts() {
    var query = (document.getElementById('search-input').value || '').toLowerCase().trim();
    var rows = document.querySelectorAll('.account-row');

    rows.forEach(function(row) {
      var name = row.getAttribute('data-name') || '';
      var email = row.getAttribute('data-email') || '';
      var status = row.getAttribute('data-status') || '';

      var matchesQuery = !query || name.includes(query) || email.includes(query);
      var matchesFilter = currentFilter === 'all' || status === currentFilter;

      if (matchesQuery && matchesFilter) {
        row.style.display = '';
      } else {
        row.style.display = 'none';
      }
    });
  }

  function showToast(message, isError) {
    var toast = document.getElementById('toast');
    if (!toast) return;

    toast.innerText = message;
    toast.className = 'fixed bottom-6 right-6 z-50 transform translate-y-0 opacity-100 transition-all duration-300 px-4 py-3 rounded-[14px] shadow-lg text-xs font-medium flex items-center gap-2 ' +
      (isError ? 'bg-red-600 text-white' : 'bg-dark text-white');

    setTimeout(function() {
      toast.className = 'fixed bottom-6 right-6 z-50 transform translate-y-12 opacity-0 transition-all duration-300 pointer-events-none px-4 py-3 rounded-[14px] shadow-lg text-xs font-medium flex items-center gap-2';
    }, 3500);
  }

  async function toggleAccountStatus(userId, newStatus, encodedName) {
    var staffName = decodeURIComponent(encodedName);
    var actionWord = newStatus ? 'reactivate' : 'deactivate';

    if (!confirm('Are you sure you want to ' + actionWord + ' ' + staffName + '? ' + (newStatus ? 'They will regain access to login and portal features.' : 'They will be immediately blocked from logging in.'))) {
      return;
    }

    var btn = document.getElementById('action-btn-' + userId);
    if (btn) {
      btn.disabled = true;
      btn.innerText = 'Updating...';
    }

    try {
      var res = await fetch('/api/admin/accounts/' + userId, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ is_active: newStatus }),
      });

      var data = await res.json();
      if (!res.ok || !data.ok) {
        throw new Error(data.error || 'Failed to update account.');
      }

      // Update row data attribute
      var row = document.getElementById('row-' + userId);
      if (row) {
        row.setAttribute('data-status', newStatus ? 'active' : 'deactivated');
      }

      // Update badge
      var badge = document.getElementById('status-badge-' + userId);
      var text = document.getElementById('status-text-' + userId);
      if (badge && text) {
        if (newStatus) {
          badge.className = 'inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-emerald-50 text-emerald-700 border border-emerald-200';
          badge.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span><span id="status-text-' + userId + '">Active</span>';
        } else {
          badge.className = 'inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-red-50 text-red-700 border border-red-200';
          badge.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-red-500"></span><span id="status-text-' + userId + '">Deactivated</span>';
        }
      }

      // Update button
      if (btn) {
        btn.disabled = false;
        if (newStatus) {
          btn.innerText = 'Deactivate';
          btn.className = 'px-3 py-1.5 rounded-[10px] text-xs font-medium transition-all text-red-700 bg-red-50 hover:bg-red-100 border border-red-200';
          btn.onclick = function() { toggleAccountStatus(userId, false, encodedName); };
        } else {
          btn.innerText = 'Reactivate';
          btn.className = 'px-3 py-1.5 rounded-[10px] text-xs font-medium transition-all text-emerald-700 bg-emerald-50 hover:bg-emerald-100 border border-emerald-200';
          btn.onclick = function() { toggleAccountStatus(userId, true, encodedName); };
        }
      }

      showToast(newStatus ? 'Account reactivated successfully.' : 'Account deactivated successfully.', false);
    } catch (err) {
      if (btn) {
        btn.disabled = false;
        btn.innerText = newStatus ? 'Reactivate' : 'Deactivate';
      }
      showToast(err.message || 'Error updating status', true);
    }
  }
</script>
