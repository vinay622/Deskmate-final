---
import MainLayout from "../layouts/MainLayout.astro";
import Section from "../components/sections/Section.astro";
import SectionTitle from "../components/ui/SectionTitle.astro";
import Card from "../components/ui/Card.astro";

const problems = [
  {
    title: "Information is Hard to Find",
    description: "Fee deadlines, exam schedules, hostel rules — they exist in PDFs and notice boards that students never check or can't locate. Critical information is scattered and inaccessible.",
    bg: "bg-green",
  },
  {
    title: "Staff Answer the Same Questions Repeatedly",
    description: "Administrative staff spend hours answering 'When is the fee deadline?' for the hundredth time each semester, diverting time from complex work that actually needs human attention.",
    bg: "bg-gray",
  },
  {
    title: "Rumours Fill the Gap",
    description: "WhatsApp groups and senior students become the de facto information source — spreading outdated or incorrect information. There's no reliable, always-available source of truth.",
    bg: "bg-dark text-gray",
  },
];

const team = [
  {
    name: "Adimulam Vinay",
    role: "Founder & Developer",
    description: "Visionary behind DeskMate who experienced the college information problem firsthand. Leads the technical development and product strategy to ensure every student has instant access to accurate information.",
  },
  {
    name: "Arutla Sowmya",
    role: "Documentation & Lead",
    description: "Ensures clear documentation and leads project coordination across teams. Manages the knowledge base that makes DeskMate's document indexing accurate and comprehensive.",
  },
  {
    name: "Janga Karthik Yadav",
    role: "Resource Manager",
    description: "Oversees resource allocation and project timelines to ensure smooth deployment across colleges. Coordinates with institutions to streamline DeskMate implementation processes.",
  },
  {
    name: "Hemanth",
    role: "Resource Manager",
    description: "Manages operational resources and supports college partnerships. Focuses on training programs and ensuring seamless integration of DeskMate into existing college systems.",
  },
];
---

<MainLayout
  title="About — DeskMate"
  description="Learn about DeskMate — the AI assistant built to solve the college information problem."
>
  <!-- Hero -->
  <Section id="about-hero">
    <div class="mt-20 mb-[80px] text-center">
      <span class="greenhead text-sm uppercase tracking-widest mb-4 inline-block">About DeskMate</span>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-medium leading-tight mb-6 max-w-3xl mx-auto">
        Built to end the<br />
        <span class="greenhead">college information problem</span>
      </h1>
      <p class="text-lg text-[#555] max-w-2xl mx-auto">
        Colleges in India are drowning in repetitive questions. Students spend hours hunting for basic information across notice boards, WhatsApp groups, and unresponsive email inboxes. DeskMate fixes this.
      </p>
    </div>
  </Section>

  <!-- The Problem -->
  <Section id="problem">
    <div class="mb-[80px]">
      <SectionTitle
        sectionTitle="The Problem"
        description="Every college has the same friction between official information and the students who need it."
      />
      <div class="grid sm:grid-cols-3 gap-5">
        {problems.map((p) => (
          <Card isUnderline={true}>
            <div class={`p-8 rounded-[45px] h-full ${p.bg}`}>
              <h3 class="text-xl font-medium mb-3">{p.title}</h3>
              <p class="text-sm leading-relaxed opacity-80">{p.description}</p>
            </div>
          </Card>
        ))}
      </div>
    </div>
  </Section>

  <!-- Our Solution -->
  <Section id="solution">
    <div class="mb-[80px]">
      <div class="bg-dark rounded-[45px] p-12 md:p-16 border border-dark shadow-[0px_5px_0px_#191a23]">
        <div class="grid md:grid-cols-2 gap-12 text-gray items-center">
          <div>
            <span class="text-green text-sm uppercase tracking-widest mb-4 block">Our Solution</span>
            <h2 class="text-3xl md:text-4xl font-medium mb-6 leading-tight">
              A 24/7 assistant that only tells the truth
            </h2>
            <p class="text-[#aaa] leading-relaxed mb-6">
              DeskMate reads all official college documents and answers student questions from that knowledge — nothing else. Every answer includes the source document and page number. Every dead end routes to a real staff member.
            </p>
            <a href="/app/chat" class="btn-tertiary px-8 py-4 rounded-2xl inline-block">
              Try It Now
            </a>
          </div>
          <div class="flex flex-col gap-4">
            {[
              "Answers only from official uploaded documents",
              "Every response cites source document and page number",
              "Works in English, Hindi, and Telugu",
              "Staff routing when AI cannot answer",
              "Admin uploads documents in under 10 minutes",
              "Automatic expiry of outdated documents",
            ].map((point) => (
              <div class="flex items-start gap-3">
                <span class="text-green mt-0.5 shrink-0">&#10003;</span>
                <span class="text-[#ccc] text-sm">{point}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </Section>

  <!-- Team -->
  <Section id="team">
    <div class="mb-[140px]">
      <div class="team-intro border-t border-dark pt-5 mb-10 grid lg:grid-cols-[1.25fr_0.75fr] gap-6 lg:items-end">
        <div>
          <p class="font-utility text-[10px] uppercase tracking-[0.18em] text-[#626671] mb-4">The people behind the desk</p>
          <h2 class="text-4xl sm:text-5xl font-medium tracking-[-0.055em] leading-[0.95]">Built by students<br /><span class="greenhead">for students.</span></h2>
        </div>
        <p class="text-[#626671] leading-relaxed max-w-lg lg:justify-self-end">We know the friction of finding a single reliable answer on campus. This is the team turning that frustration into a better daily experience.</p>
      </div>
      <div class="team-grid grid sm:grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-5">
        {team.map((member, index) => (
          <div class={index === 0 ? 'sm:col-span-2' : ''}>
            <Card isUnderline={true}>
              <article class={`team-card rounded-[27px] p-6 sm:p-7 h-full flex flex-col ${index === 0 ? 'team-card-featured bg-dark text-white' : 'bg-gray text-dark'}`}>
              <div class="flex items-start justify-between gap-4 mb-auto">
                <div class={`team-monogram size-14 sm:size-16 rounded-[18px] flex items-center justify-center ${index === 0 ? 'bg-green text-dark' : 'bg-dark text-green'}`}>
                  <span class="text-2xl sm:text-3xl font-medium tracking-[-0.08em]">{member.name.charAt(0)}</span>
                </div>
                <span class={`font-utility text-[10px] uppercase tracking-wider ${index === 0 ? 'text-[#aeb3bb]' : 'text-[#777b84]'}`}>Team / 0{index + 1}</span>
              </div>
              <div class="mt-12">
                <p class={`font-utility text-[10px] uppercase tracking-[0.16em] mb-2 ${index === 0 ? 'text-green' : 'text-[#626671]'}`}>{member.role}</p>
                <h3 class={`font-medium text-2xl leading-none tracking-[-0.045em] ${index === 0 ? 'text-white' : 'text-dark'}`}>{member.name}</h3>
                <div class={`team-rule h-px my-5 ${index === 0 ? 'bg-[#3b3d49]' : 'bg-[#d9dadd]'}`}></div>
                <p class={`text-sm leading-relaxed ${index === 0 ? 'text-[#c9cdd3]' : 'text-[#555b64]'}`}>{member.description}</p>
              </div>
              </article>
            </Card>
          </div>
        ))}
      </div>
    </div>
  </Section>
</MainLayout>

<style>
  .team-card { min-height: 300px; transition: transform 220ms ease, box-shadow 220ms ease; }
  .team-card:hover { transform: translateY(-5px); box-shadow: 0 16px 28px rgba(25, 26, 35, 0.12); }
  .team-card:hover .team-monogram { transform: rotate(-4deg) scale(1.04); }
  .team-monogram { transition: transform 220ms ease; }
  .team-card:hover .team-rule { transform: scaleX(0.84); transform-origin: left; }
  .team-rule { transition: transform 220ms ease; }
  .team-card-featured { min-height: 350px; }
  @media (max-width: 639px) { .team-card, .team-card-featured { min-height: 290px; } }
</style>
