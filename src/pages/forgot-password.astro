---
import AuthLayout from "../layouts/AuthLayout.astro";
---

<AuthLayout
  title="Forgot Password — DeskMate"
  description="Reset your DeskMate password using a secure 6-digit verification code."
>
  <div class="min-h-screen flex">

    <!-- ═══ LEFT PANEL ═══ -->
    <div class="hidden lg:flex lg:w-[55%] bg-dark flex-col relative overflow-hidden px-16 py-12">

      <!-- Background decorative blobs -->
      <div class="absolute top-[-80px] left-[-80px] w-[340px] h-[340px] rounded-full bg-green opacity-[0.07] blur-[80px] pointer-events-none"></div>
      <div class="absolute bottom-[-60px] right-[-60px] w-[280px] h-[280px] rounded-full bg-green opacity-[0.05] blur-[100px] pointer-events-none"></div>
      <div class="absolute top-[45%] right-[5%] w-[180px] h-[180px] rounded-full bg-green opacity-[0.04] blur-[60px] pointer-events-none"></div>

      <!-- Dot grid overlay -->
      <div class="absolute inset-0 pointer-events-none" style="background-image: radial-gradient(circle, rgba(185,255,102,0.08) 1px, transparent 1px); background-size: 28px 28px;"></div>

      <!-- Logo -->
      <a href="/" class="relative z-10 flex items-center gap-2 mb-auto">
        <span class="text-2xl font-medium text-white">
          Desk<span class="text-green">Mate</span>
        </span>
        <span class="text-xs text-[#555] border border-[#2d2e3a] rounded-full px-2 py-0.5 ml-1">Account Security</span>
      </a>

      <!-- Copy -->
      <div class="relative z-10 mt-16 mb-12">
        <p class="text-green text-sm uppercase tracking-widest font-medium mb-4">Password Recovery</p>
        <h1 class="text-4xl xl:text-5xl font-medium text-white leading-tight mb-6">
          Recover your access.<br />
          Quickly & securely.<br />
          <span class="text-green">Back to learning.</span>
        </h1>
        <p class="text-[#888] text-base leading-relaxed max-w-md">
          Enter your registered college email. We will send an encrypted 6-digit verification code directly to your inbox.
        </p>
      </div>

      <!-- Security tips -->
      <div class="relative z-10 flex flex-col gap-3 mb-14">
        {[
          { icon: "🔢", text: "Instant one-time verification code" },
          { icon: "🛡️", text: "Protected against bot & link scanner expiration" },
          { icon: "⚡", text: "Delivered straight to your personal or college inbox" },
        ].map((f) => (
          <div class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-full bg-[#1e1f2e] border border-[#2d2e3a] flex items-center justify-center text-sm shrink-0">{f.icon}</span>
            <span class="text-[#aaa] text-sm">{f.text}</span>
          </div>
        ))}
      </div>

      <!-- Stat pills row -->
      <div class="relative z-10 flex gap-3 flex-wrap">
        <div class="bg-[#1e1f2e] border border-[#2d2e3a] rounded-full px-4 py-1.5 flex items-center gap-2">
          <div class="w-1.5 h-1.5 rounded-full bg-green"></div>
          <span class="text-[#aaa] text-xs">Direct OTP verification</span>
        </div>
        <div class="bg-[#1e1f2e] border border-[#2d2e3a] rounded-full px-4 py-1.5 flex items-center gap-2">
          <div class="w-1.5 h-1.5 rounded-full bg-green"></div>
          <span class="text-[#aaa] text-xs">24/7 Available</span>
        </div>
      </div>

    </div>

    <!-- ═══ RIGHT PANEL ═══ -->
    <div class="w-full lg:w-[45%] bg-white flex flex-col">

      <!-- Mobile logo -->
      <div class="lg:hidden flex items-center justify-between px-8 pt-8 pb-4 border-b border-[#eee]">
        <a href="/" class="text-xl font-medium text-dark">
          Desk<span style="background:#b9ff66;border-radius:7px;padding:0 7px;">Mate</span>
        </a>
        <a href="/login" class="text-sm text-[#666] underline">← Back to sign in</a>
      </div>

      <!-- Container -->
      <div class="flex-1 flex flex-col justify-center px-8 sm:px-14 lg:px-16 py-12">

        <!-- Back to login link -->
        <a href="/login" class="inline-flex items-center gap-1.5 text-xs text-[#888] hover:text-dark mb-6 transition-colors group">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="group-hover:-translate-x-0.5 transition-transform"><path d="m15 18-6-6 6-6"/></svg>
          Back to Sign In
        </a>

        <!-- Global Error Banner -->
        <div id="error-banner" class="hidden mb-6 bg-red-50 border border-red-200 text-red-700 rounded-[14px] px-4 py-3 text-sm flex items-center gap-2">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <span id="error-message"></span>
        </div>

        <!-- Success Banner -->
        <div id="success-banner" class="hidden mb-6 bg-[#f0fdf4] border border-[#bbf7d0] text-[#166534] rounded-[14px] px-4 py-3 text-sm flex items-center gap-2">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 text-[#16a34a]"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <span id="success-message">Password reset successfully! Redirecting to sign in...</span>
        </div>

        <!-- ═══════════════════════════════════════ -->
        <!-- STEP 1: Enter Email                     -->
        <!-- ═══════════════════════════════════════ -->
        <div id="step-1-card">
          <div class="mb-8">
            <p class="text-xs text-[#aaa] uppercase tracking-widest mb-2">Step 1 of 2</p>
            <h2 class="text-3xl font-medium text-dark mb-2">Reset Password</h2>
            <p class="text-[#888] text-sm leading-relaxed">
              Enter your college email address. We'll send you a 6-digit verification code.
            </p>
          </div>

          <form id="email-form" class="flex flex-col gap-5" onsubmit="handleSendCode(event)">
            <div class="flex flex-col gap-1.5">
              <label class="text-sm font-medium text-dark" for="email">College Email Address</label>
              <div class="relative">
                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-[#aaa]">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                </span>
                <input
                  type="email"
                  id="email"
                  name="email"
                  placeholder="you@college.edu.in"
                  required
                  autocomplete="email"
                  class="w-full pl-10 pr-4 py-3.5 border border-[#e0e0e0] rounded-[14px] text-dark text-sm outline-none focus:border-dark focus:ring-2 focus:ring-green/20 transition-all"
                />
              </div>
            </div>

            <button
              type="submit"
              id="send-code-btn"
              class="w-full bg-dark text-white py-4 rounded-[14px] font-medium text-sm hover:bg-green hover:text-dark transition-all duration-200 transform hover:scale-[1.01] active:scale-[0.99] mt-2 flex items-center justify-center gap-2 shadow-sm"
            >
              <span id="send-btn-text">Send Verification Code</span>
              <svg id="send-btn-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              <svg id="send-btn-spinner" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="hidden animate-spin"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
            </button>
          </form>
        </div>

        <!-- ═══════════════════════════════════════ -->
        <!-- STEP 2: Enter Code & New Password       -->
        <!-- ═══════════════════════════════════════ -->
        <div id="step-2-card" class="hidden">
          <div class="mb-6">
            <p class="text-xs text-[#aaa] uppercase tracking-widest mb-1">Step 2 of 2</p>
            <h2 class="text-2xl sm:text-3xl font-medium text-dark mb-2">Enter Verification Code</h2>
            <div class="flex items-center gap-2 text-xs text-[#666]">
              <span>Code sent to <strong id="display-target-email" class="text-dark font-medium"></strong></span>
              <span>·</span>
              <button type="button" onclick="goToStep1()" class="text-dark underline hover:text-green transition-colors">Change email</button>
            </div>
          </div>

          <form id="reset-form" class="flex flex-col gap-4" onsubmit="handleVerifyAndReset(event)">
            
            <!-- Code Input -->
            <div class="flex flex-col gap-1.5">
              <div class="flex justify-between items-center">
                <label class="text-sm font-medium text-dark" for="otp-code">Verification Code</label>
                <button type="button" id="resend-link" onclick="handleResendCode()" class="text-xs text-[#888] hover:text-dark transition-colors underline">Resend Code</button>
              </div>
              <div class="relative">
                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-[#aaa]">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                </span>
                <input
                  type="text"
                  id="otp-code"
                  name="otp"
                  placeholder="e.g. 40605742"
                  required
                  maxlength="10"
                  inputmode="numeric"
                  autocomplete="one-time-code"
                  class="w-full pl-10 pr-4 py-3.5 border border-[#e0e0e0] rounded-[14px] text-dark text-base tracking-[0.25em] font-mono outline-none focus:border-dark focus:ring-2 focus:ring-green/20 transition-all text-center sm:text-left"
                />
              </div>
            </div>

            <!-- New Password -->
            <div class="flex flex-col gap-1.5">
              <label class="text-sm font-medium text-dark" for="new-password">New Password</label>
              <div class="relative">
                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-[#aaa]">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                </span>
                <input
                  type="password"
                  id="new-password"
                  name="password"
                  placeholder="At least 6 characters"
                  required
                  minlength="6"
                  class="w-full pl-10 pr-12 py-3.5 border border-[#e0e0e0] rounded-[14px] text-dark text-sm outline-none focus:border-dark focus:ring-2 focus:ring-green/20 transition-all"
                />
                <button type="button" onclick="togglePasswordVisibility('new-password', 'eye1')" class="absolute right-4 top-1/2 -translate-y-1/2 text-[#aaa] hover:text-dark transition-colors">
                  <svg id="eye1" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                </button>
              </div>
            </div>

            <!-- Confirm Password -->
            <div class="flex flex-col gap-1.5">
              <label class="text-sm font-medium text-dark" for="confirm-password">Confirm Password</label>
              <div class="relative">
                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-[#aaa]">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                </span>
                <input
                  type="password"
                  id="confirm-password"
                  name="confirmPassword"
                  placeholder="Repeat new password"
                  required
                  minlength="6"
                  class="w-full pl-10 pr-12 py-3.5 border border-[#e0e0e0] rounded-[14px] text-dark text-sm outline-none focus:border-dark focus:ring-2 focus:ring-green/20 transition-all"
                />
                <button type="button" onclick="togglePasswordVisibility('confirm-password', 'eye2')" class="absolute right-4 top-1/2 -translate-y-1/2 text-[#aaa] hover:text-dark transition-colors">
                  <svg id="eye2" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                </button>
              </div>
            </div>

            <!-- Reset Button -->
            <button
              type="submit"
              id="reset-btn"
              class="w-full bg-dark text-white py-4 rounded-[14px] font-medium text-sm hover:bg-green hover:text-dark transition-all duration-200 transform hover:scale-[1.01] active:scale-[0.99] mt-2 flex items-center justify-center gap-2 shadow-sm"
            >
              <span id="reset-btn-text">Reset Password & Sign In</span>
              <svg id="reset-btn-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              <svg id="reset-btn-spinner" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="hidden animate-spin"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
            </button>
          </form>
        </div>

        <!-- Footer -->
        <p class="text-center text-sm text-[#888] mt-10">
          Remember your password?
          <a href="/login" class="text-dark font-medium hover:text-green transition-colors underline underline-offset-2">Sign in</a>
        </p>

      </div>

      <!-- Bottom bar -->
      <div class="hidden lg:flex items-center justify-between px-16 py-5 border-t border-[#f0f0f0]">
        <a href="/" class="text-xs text-[#bbb] hover:text-dark transition-colors">← Back to home</a>
        <span class="text-xs text-[#ccc]">© 2024 DeskMate</span>
        <a href="/signup" class="text-xs text-[#888] hover:text-dark transition-colors underline">Create account</a>
      </div>

    </div>
  </div>

</AuthLayout>

<script is:inline>
  var targetEmail = '';
  var resendCountdown = 0;
  var resendTimerInterval = null;

  function showError(msg) {
    var banner = document.getElementById('error-banner');
    var msgEl = document.getElementById('error-message');
    msgEl.textContent = msg;
    banner.classList.remove('hidden');
  }

  function hideError() {
    var banner = document.getElementById('error-banner');
    banner.classList.add('hidden');
  }

  function goToStep1() {
    hideError();
    document.getElementById('step-2-card').classList.add('hidden');
    document.getElementById('step-1-card').classList.remove('hidden');
    if (targetEmail) {
      document.getElementById('email').value = targetEmail;
    }
  }

  function goToStep2(email) {
    hideError();
    targetEmail = email;
    document.getElementById('display-target-email').textContent = email;
    document.getElementById('step-1-card').classList.add('hidden');
    document.getElementById('step-2-card').classList.remove('hidden');
    document.getElementById('otp-code').focus();
    startResendCountdown(30);
  }

  function startResendCountdown(seconds) {
    resendCountdown = seconds;
    var link = document.getElementById('resend-link');
    if (resendTimerInterval) clearInterval(resendTimerInterval);

    link.style.pointerEvents = 'none';
    link.style.opacity = '0.5';
    link.textContent = 'Resend in ' + resendCountdown + 's';

    resendTimerInterval = setInterval(function() {
      resendCountdown--;
      if (resendCountdown <= 0) {
        clearInterval(resendTimerInterval);
        link.style.pointerEvents = 'auto';
        link.style.opacity = '1';
        link.textContent = 'Resend Code';
      } else {
        link.textContent = 'Resend in ' + resendCountdown + 's';
      }
    }, 1000);
  }

  // Step 1: Send Code
  function handleSendCode(e) {
    e.preventDefault();
    hideError();

    var emailInput = document.getElementById('email');
    var email = emailInput.value.trim().toLowerCase();
    if (!email) return;

    var btn = document.getElementById('send-code-btn');
    var text = document.getElementById('send-btn-text');
    var arrow = document.getElementById('send-btn-arrow');
    var spinner = document.getElementById('send-btn-spinner');

    btn.disabled = true;
    text.textContent = 'Sending code...';
    arrow.classList.add('hidden');
    spinner.classList.remove('hidden');

    fetch('/api/auth/forgot-password', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: email })
    })
      .then(function(res) { return res.json(); })
      .then(function(data) {
        if (data.ok) {
          goToStep2(email);
        } else {
          showError(data.error || 'Failed to send verification code. Please check your email.');
        }
      })
      .catch(function() {
        showError('Network error. Please check your internet connection.');
      })
      .finally(function() {
        btn.disabled = false;
        text.textContent = 'Send Verification Code';
        arrow.classList.remove('hidden');
        spinner.classList.add('hidden');
      });
  }

  // Resend Code
  function handleResendCode() {
    if (!targetEmail || resendCountdown > 0) return;
    hideError();

    var link = document.getElementById('resend-link');
    link.textContent = 'Sending...';

    fetch('/api/auth/forgot-password', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: targetEmail })
    })
      .then(function(res) { return res.json(); })
      .then(function(data) {
        if (data.ok) {
          startResendCountdown(45);
        } else {
          showError(data.error || 'Failed to resend code.');
          link.textContent = 'Resend Code';
        }
      })
      .catch(function() {
        showError('Network error while resending.');
        link.textContent = 'Resend Code';
      });
  }

  // Step 2: Verify Code and Reset Password
  function handleVerifyAndReset(e) {
    e.preventDefault();
    hideError();

    var otpInput = document.getElementById('otp-code');
    var pwInput = document.getElementById('new-password');
    var confirmInput = document.getElementById('confirm-password');

    var otp = otpInput.value.replace(/\s+/g, '').trim();
    var password = pwInput.value.trim();
    var confirm = confirmInput.value.trim();

    if (otp.length < 6) {
      showError('Please enter the complete verification code.');
      otpInput.focus();
      return;
    }

    if (password.length < 6) {
      showError('Password must be at least 6 characters long.');
      pwInput.focus();
      return;
    }

    if (password !== confirm) {
      showError('Passwords do not match. Please verify.');
      confirmInput.focus();
      return;
    }

    var btn = document.getElementById('reset-btn');
    var text = document.getElementById('reset-btn-text');
    var arrow = document.getElementById('reset-btn-arrow');
    var spinner = document.getElementById('reset-btn-spinner');

    btn.disabled = true;
    text.textContent = 'Resetting password...';
    arrow.classList.add('hidden');
    spinner.classList.remove('hidden');

    fetch('/api/auth/verify-otp-reset', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        email: targetEmail,
        otp: otp,
        password: password
      })
    })
      .then(function(res) { return res.json(); })
      .then(function(data) {
        if (data.ok) {
          var successBanner = document.getElementById('success-banner');
          successBanner.classList.remove('hidden');
          document.getElementById('reset-form').classList.add('opacity-50', 'pointer-events-none');
          setTimeout(function() {
            window.location.href = '/login?reset=success';
          }, 1500);
        } else {
          showError(data.error || 'Failed to reset password. Please check your verification code.');
          btn.disabled = false;
          text.textContent = 'Reset Password & Sign In';
          arrow.classList.remove('hidden');
          spinner.classList.add('hidden');
        }
      })
      .catch(function() {
        showError('Network error. Please try again.');
        btn.disabled = false;
        text.textContent = 'Reset Password & Sign In';
        arrow.classList.remove('hidden');
        spinner.classList.add('hidden');
      });
  }

  // Password visibility toggler
  function togglePasswordVisibility(inputId, iconId) {
    var input = document.getElementById(inputId);
    var icon = document.getElementById(iconId);
    if (!input) return;
    if (input.type === 'password') {
      input.type = 'text';
      if (icon) icon.style.opacity = '0.4';
    } else {
      input.type = 'password';
      if (icon) icon.style.opacity = '1';
    }
  }
</script>
