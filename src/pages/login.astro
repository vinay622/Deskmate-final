---
import AuthLayout from "../layouts/AuthLayout.astro";
const next = Astro.url.searchParams.get("next") ?? "";
---

<AuthLayout
  title="Sign In — DeskMate"
  description="Sign in to DeskMate and get instant answers from your college's official documents."
>
  <div class="min-h-screen flex">

    <!-- ═══ LEFT PANEL ═══ -->
    <div class="hidden lg:flex lg:w-[55%] bg-dark flex-col relative overflow-hidden px-16 py-12">

      <!-- Background decorative blobs -->
      <div class="absolute top-[-80px] left-[-80px] w-[340px] h-[340px] rounded-full bg-green opacity-[0.07] blur-[80px] pointer-events-none"></div>
      <div class="absolute bottom-[-60px] right-[-60px] w-[280px] h-[280px] rounded-full bg-green opacity-[0.05] blur-[100px] pointer-events-none"></div>
      <div class="absolute top-[45%] right-[5%] w-[180px] h-[180px] rounded-full bg-green opacity-[0.04] blur-[60px] pointer-events-none"></div>

      <!-- Dot grid overlay -->
      <div class="absolute inset-0 pointer-events-none" style="background-image: radial-gradient(circle, rgba(185,255,102,0.08) 1px, transparent 1px); background-size: 28px 28px;"></div>

      <!-- Logo -->
      <a href="/" class="relative z-10 flex items-center gap-2 mb-auto">
        <span class="text-2xl font-medium text-white">
          Desk<span class="text-green">Mate</span>
        </span>
        <span class="text-xs text-[#555] border border-[#2d2e3a] rounded-full px-2 py-0.5 ml-1">Beta</span>
      </a>

      <!-- Main copy -->
      <div class="relative z-10 mt-16 mb-12">
        <p class="text-green text-sm uppercase tracking-widest font-medium mb-4">College AI Assistant</p>
        <h1 class="text-4xl xl:text-5xl font-medium text-white leading-tight mb-6">
          Every answer.<br />
          Every source.<br />
          <span class="text-green">Every time.</span>
        </h1>
        <p class="text-[#888] text-base leading-relaxed max-w-md">
          Sign in to access your college's entire knowledge base — fees, exams, hostel, scholarships — answered instantly from official documents.
        </p>
      </div>

      <!-- Feature highlights -->
      <div class="relative z-10 flex flex-col gap-3 mb-14">
        {[
          { icon: "📄", text: "Answers from official college documents only" },
          { icon: "🔗", text: "Every response cites the exact source & page" },
          { icon: "🌐", text: "Works in English, Hindi and Telugu" },
        ].map((f) => (
          <div class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-full bg-[#1e1f2e] border border-[#2d2e3a] flex items-center justify-center text-sm shrink-0">{f.icon}</span>
            <span class="text-[#aaa] text-sm">{f.text}</span>
          </div>
        ))}
      </div>

      <!-- Floating chat card -->
      <div class="relative z-10 mb-6" style="animation: floatCard 6s ease-in-out infinite;">
        <div class="bg-[#0f1019] border border-[#2d2e3a] rounded-[24px] p-5 max-w-sm shadow-[0px_20px_60px_rgba(0,0,0,0.5)]">
          <!-- Card header -->
          <div class="flex items-center gap-2 mb-4 pb-3 border-b border-[#1e1f2e]">
            <div class="w-2 h-2 rounded-full bg-green animate-pulse"></div>
            <span class="text-[#666] text-xs">DeskMate AI · answering now</span>
          </div>
          <!-- Question -->
          <div class="flex justify-end mb-3">
            <div class="bg-green text-dark rounded-[14px] rounded-br-[4px] px-3 py-2 text-xs max-w-[75%] font-medium">
              When is the last date to pay fees?
            </div>
          </div>
          <!-- Answer -->
          <div class="flex justify-start mb-2">
            <div class="bg-[#1e1f2e] text-gray border border-[#2d2e3a] rounded-[14px] rounded-bl-[4px] px-3 py-2 text-xs max-w-[85%] leading-relaxed">
              The last date to pay fees without fine is the <strong class="text-white">15th of the month</strong> following semester start.
            </div>
          </div>
          <!-- Citation -->
          <div class="flex justify-start">
            <span class="inline-flex items-center gap-1.5 bg-dark border border-green text-green text-[10px] px-2.5 py-1 rounded-full">
              <svg width="8" height="10" viewBox="0 0 10 12" fill="currentColor"><path d="M1 0h8v12H1V0zm2 3h4v1H3V3zm0 2h4v1H3V5zm0 2h3v1H3V7z"/></svg>
              Fee Structure 2024-25.pdf · p.3
            </span>
          </div>
        </div>
      </div>

      <!-- Stat pills row -->
      <div class="relative z-10 flex gap-3 flex-wrap">
        <div class="bg-[#1e1f2e] border border-[#2d2e3a] rounded-full px-4 py-1.5 flex items-center gap-2">
          <div class="w-1.5 h-1.5 rounded-full bg-green"></div>
          <span class="text-[#aaa] text-xs">24/7 Available</span>
        </div>
        <div class="bg-[#1e1f2e] border border-[#2d2e3a] rounded-full px-4 py-1.5 flex items-center gap-2">
          <div class="w-1.5 h-1.5 rounded-full bg-green"></div>
          <span class="text-[#aaa] text-xs">0 Hallucinations</span>
        </div>
        <div class="bg-[#1e1f2e] border border-[#2d2e3a] rounded-full px-4 py-1.5 flex items-center gap-2">
          <div class="w-1.5 h-1.5 rounded-full bg-green"></div>
          <span class="text-[#aaa] text-xs">3 Languages</span>
        </div>
      </div>

    </div>

    <!-- ═══ RIGHT PANEL ═══ -->
    <div class="w-full lg:w-[45%] bg-white flex flex-col">

      <!-- Mobile logo -->
      <div class="lg:hidden flex items-center justify-between px-8 pt-8 pb-4 border-b border-[#eee]">
        <a href="/" class="text-xl font-medium text-dark">
          Desk<span style="background:#b9ff66;border-radius:7px;padding:0 7px;">Mate</span>
        </a>
        <a href="/" class="text-sm text-[#666] underline">← Back home</a>
      </div>

      <!-- Form area -->
      <div class="flex-1 flex flex-col justify-center px-8 sm:px-14 lg:px-16 py-12">

        <!-- Reset success banner -->
        {Astro.url.searchParams.get("reset") === "success" && (
          <div class="mb-6 bg-[#f0fdf4] border border-[#bbf7d0] text-[#166534] rounded-[14px] px-4 py-3 text-sm flex items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 text-[#16a34a]"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <span>Password updated successfully. Please sign in with your new password.</span>
          </div>
        )}

        <!-- Registered success banner -->
        {Astro.url.searchParams.get("registered") === "1" && (
          <div class="mb-6 bg-[#f0fdf4] border border-[#bbf7d0] text-[#166534] rounded-[14px] px-4 py-3 text-sm flex items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 text-[#16a34a]"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <span>Account created successfully! Please sign in with your credentials to verify your account.</span>
          </div>
        )}

        <!-- Deactivated banner -->
        {Astro.url.searchParams.get("error") === "deactivated" && (
          <div class="mb-6 bg-red-50 border border-red-200 text-red-700 rounded-[14px] px-4 py-3 text-sm flex items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <span>Your account has been deactivated. Please contact your college administrator.</span>
          </div>
        )}

        <!-- Deleted / not found banner -->
        {Astro.url.searchParams.get("error") === "account_not_found" && (
          <div class="mb-6 bg-amber-50 border border-amber-200 text-amber-800 rounded-[14px] px-4 py-3 text-sm flex items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 text-amber-600"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <span>This account has been removed or does not exist. Please register for a new account.</span>
          </div>
        )}

        <!-- Error banner (hidden by default) -->
        <div id="error-banner" class="hidden mb-6 bg-red-50 border border-red-200 text-red-700 rounded-[14px] px-4 py-3 text-sm flex items-center gap-2">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <span id="error-message"></span>
        </div>

        <!-- Info / Success banner (hidden by default) -->
        <div id="info-banner" class="hidden mb-6 bg-[#f0fdf4] border border-[#bbf7d0] text-[#166534] rounded-[14px] px-4 py-3 text-sm flex items-center gap-2">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 text-[#16a34a]"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <span id="info-message"></span>
        </div>

        <!-- ═══ STEP 1: EMAIL & PASSWORD ═══ -->
        <div id="step-1-card">
          <!-- Heading -->
          <div class="mb-10">
            <p class="text-xs text-[#aaa] uppercase tracking-widest mb-2">Welcome back</p>
            <h2 class="text-3xl font-medium text-dark mb-2">Sign in to DeskMate</h2>
            <p class="text-[#888] text-sm">Access your college's knowledge base instantly.</p>
          </div>

          <!-- Role tabs -->
          <div class="flex gap-2 mb-8 bg-[#f3f3f3] rounded-[14px] p-1.5">
            <button id="tab-student" type="button" onclick="switchTab('student')" class="flex-1 py-2.5 px-4 rounded-[10px] text-sm font-medium transition-all duration-200 bg-dark text-white shadow-sm">
              Student
            </button>
            <button id="tab-staff" type="button" onclick="switchTab('staff')" class="flex-1 py-2.5 px-4 rounded-[10px] text-sm font-medium transition-all duration-200 text-[#888]">
              Staff / Admin
            </button>
          </div>

          <!-- Form -->
          <form id="login-form" class="flex flex-col gap-5" onsubmit="handleLogin(event)">
            <input type="hidden" name="next" value={next} />

            <!-- Email -->
            <div class="flex flex-col gap-1.5">
              <label class="text-sm font-medium text-dark" for="email">College Email</label>
              <div class="relative">
                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-[#aaa]">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                </span>
                <input
                  type="email"
                  id="email"
                  name="email"
                  placeholder="you@college.edu.in"
                  required
                  class="w-full pl-10 pr-4 py-3.5 border border-[#e0e0e0] rounded-[14px] text-dark text-sm outline-none focus:border-dark focus:ring-2 focus:ring-green/20 transition-all"
                />
              </div>
            </div>

            <!-- Password -->
            <div class="flex flex-col gap-1.5">
              <div class="flex justify-between items-center">
                <label class="text-sm font-medium text-dark" for="password">Password</label>
                <a href="/forgot-password" class="text-xs text-[#888] hover:text-dark transition-colors underline">Forgot password?</a>
              </div>
              <div class="relative">
                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-[#aaa]">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                </span>
                <input
                  type="password"
                  id="password"
                  name="password"
                  placeholder="Enter your password"
                  required
                  class="w-full pl-10 pr-12 py-3.5 border border-[#e0e0e0] rounded-[14px] text-dark text-sm outline-none focus:border-dark focus:ring-2 focus:ring-green/20 transition-all"
                />
                <button type="button" id="toggle-pw" class="absolute right-4 top-1/2 -translate-y-1/2 text-[#aaa] hover:text-dark transition-colors">
                  <svg id="eye-open" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                  <svg id="eye-closed" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="hidden"><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" x2="22" y1="2" y2="22"/></svg>
                </button>
              </div>
            </div>

            <!-- Trust this device checkbox -->
            <div class="flex items-start gap-3 p-3.5 rounded-[14px] bg-[#f9f9fb] border border-[#ebebed]">
              <input
                type="checkbox"
                id="trust_device"
                name="trust_device"
                value="true"
                checked
                class="w-4 h-4 mt-0.5 rounded border-[#ccc] accent-dark cursor-pointer shrink-0"
              />
              <label for="trust_device" class="text-xs text-[#666] cursor-pointer select-none">
                <span class="font-medium text-dark block text-sm mb-0.5">Trust this device for 30 days</span>
                Skip 2FA verification codes on this browser for the next month.
              </label>
            </div>

            <!-- Submit -->
            <button
              type="submit"
              id="submit-btn"
              class="w-full bg-dark text-white py-4 rounded-[14px] font-medium text-sm hover:bg-green hover:text-dark transition-all duration-200 transform hover:scale-[1.01] active:scale-[0.99] mt-1 flex items-center justify-center gap-2"
            >
              <span id="btn-text">Sign In</span>
              <svg id="btn-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              <svg id="btn-spinner" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="hidden animate-spin"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
            </button>
          </form>

          <!-- Sign up link -->
          <p class="text-center text-sm text-[#888] mt-8">
            Don't have an account?
            <a href="/signup" class="text-dark font-medium hover:text-green transition-colors underline underline-offset-2">Create one free</a>
          </p>

          <!-- Footer legal links -->
          <div class="mt-8 pt-6 border-t border-[#f0f0f0] flex items-center justify-center gap-4 text-xs text-[#aaa]">
            <a href="/terms" class="hover:text-dark transition-colors">Terms of Service</a>
            <span>&bull;</span>
            <a href="/privacy" class="hover:text-dark transition-colors">Privacy Policy</a>
          </div>
        </div>

        <!-- ═══ STEP 2: 2FA OTP VERIFICATION ═══ -->
        <div id="step-2-card" class="hidden">
          <!-- Step 2 Header -->
          <div class="mb-8">
            <div class="w-12 h-12 rounded-2xl bg-green/20 border border-green/30 text-dark flex items-center justify-center mb-4">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              </svg>
            </div>
            <p class="text-xs text-[#aaa] uppercase tracking-widest mb-1">Step 2 of 2 · 2FA Security</p>
            <h2 class="text-3xl font-medium text-dark mb-2">Two-Factor Authentication</h2>
            <p class="text-sm text-[#666]">
              We sent an 8-digit verification code to
              <strong id="step-2-email" class="text-dark font-medium"></strong>.
            </p>
          </div>

          <!-- Step 2 Form -->
          <form id="otp-form" class="flex flex-col gap-5" onsubmit="handleVerify2FA(event)">
            <!-- Code input -->
            <div class="flex flex-col gap-1.5">
              <div class="flex justify-between items-center">
                <label class="text-sm font-medium text-dark" for="otp-code">Verification Code</label>
                <button
                  type="button"
                  id="resend-btn"
                  onclick="handleResendCode()"
                  class="text-xs text-dark hover:text-green underline font-medium transition-colors"
                >
                  Resend code
                </button>
              </div>
              <div class="relative">
                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-[#aaa]">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                  </svg>
                </span>
                <input
                  type="text"
                  id="otp-code"
                  name="otp"
                  placeholder="e.g. 40605742"
                  required
                  maxlength="10"
                  inputmode="numeric"
                  autocomplete="one-time-code"
                  class="w-full pl-11 pr-4 py-3.5 border border-[#e0e0e0] rounded-[14px] text-dark text-lg tracking-[0.25em] font-mono outline-none focus:border-dark focus:ring-2 focus:ring-green/20 transition-all text-center sm:text-left"
                />
              </div>
              <div class="flex items-center justify-between text-xs text-[#888] mt-1">
                <span>Enter the 8-digit code from your email</span>
                <span id="countdown-text" class="text-[#aaa]"></span>
              </div>
            </div>

            <!-- Verify Submit -->
            <button
              type="submit"
              id="verify-btn"
              class="w-full bg-dark text-white py-4 rounded-[14px] font-medium text-sm hover:bg-green hover:text-dark transition-all duration-200 transform hover:scale-[1.01] active:scale-[0.99] mt-2 flex items-center justify-center gap-2"
            >
              <span id="verify-text">Verify & Sign In</span>
              <svg id="verify-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              <svg id="verify-spinner" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="hidden animate-spin"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
            </button>

            <!-- Back to step 1 -->
            <button
              type="button"
              onclick="goToStep1()"
              class="w-full border border-[#e0e0e0] hover:border-dark text-[#666] hover:text-dark py-3.5 rounded-[14px] text-sm font-medium transition-all duration-200 flex items-center justify-center gap-2 mt-1"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
              Use a different account
            </button>
          </form>
        </div>

      </div>

      <!-- Bottom bar -->
      <div class="hidden lg:flex items-center justify-between px-16 py-5 border-t border-[#f0f0f0]">
        <a href="/" class="text-xs text-[#bbb] hover:text-dark transition-colors">← Back to home</a>
        <span class="text-xs text-[#ccc]">© 2024 DeskMate</span>
        <a href="/signup" class="text-xs text-[#888] hover:text-dark transition-colors underline">Create account</a>
      </div>

    </div>
  </div>

</AuthLayout>

<style>
  @keyframes floatCard {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-10px); }
  }

  input:focus {
    box-shadow: 0 0 0 3px rgba(185, 255, 102, 0.15);
  }
</style>

<script is:inline>
  var resendTimer = null;
  var resendCountdown = 0;

  function switchTab(role) {
    var student = document.getElementById('tab-student');
    var staff = document.getElementById('tab-staff');
    var emailInput = document.getElementById('email');

    if (role === 'student') {
      student.classList.add('bg-dark', 'text-white', 'shadow-sm');
      student.classList.remove('text-[#888]');
      staff.classList.remove('bg-dark', 'text-white', 'shadow-sm');
      staff.classList.add('text-[#888]');
      emailInput.placeholder = 'you@college.edu.in';
    } else {
      staff.classList.add('bg-dark', 'text-white', 'shadow-sm');
      staff.classList.remove('text-[#888]');
      student.classList.remove('bg-dark', 'text-white', 'shadow-sm');
      student.classList.add('text-[#888]');
      emailInput.placeholder = 'admin@college.edu.in';
    }
  }

  // Password toggle
  var togglePwBtn = document.getElementById('toggle-pw');
  if (togglePwBtn) {
    togglePwBtn.addEventListener('click', function() {
      var pw = document.getElementById('password');
      var open = document.getElementById('eye-open');
      var closed = document.getElementById('eye-closed');
      if (pw.type === 'password') {
        pw.type = 'text';
        open.classList.add('hidden');
        closed.classList.remove('hidden');
      } else {
        pw.type = 'password';
        open.classList.remove('hidden');
        closed.classList.add('hidden');
      }
    });
  }

  function hideBanners() {
    var errorBanner = document.getElementById('error-banner');
    var infoBanner = document.getElementById('info-banner');
    if (errorBanner) errorBanner.classList.add('hidden');
    if (infoBanner) infoBanner.classList.add('hidden');
  }

  function showError(msg) {
    var errorBanner = document.getElementById('error-banner');
    var errorMsg = document.getElementById('error-message');
    var infoBanner = document.getElementById('info-banner');
    if (infoBanner) infoBanner.classList.add('hidden');
    if (errorBanner && errorMsg) {
      errorMsg.textContent = msg;
      errorBanner.classList.remove('hidden');
    }
  }

  function showInfo(msg) {
    var errorBanner = document.getElementById('error-banner');
    var infoBanner = document.getElementById('info-banner');
    var infoMsg = document.getElementById('info-message');
    if (errorBanner) errorBanner.classList.add('hidden');
    if (infoBanner && infoMsg) {
      infoMsg.textContent = msg;
      infoBanner.classList.remove('hidden');
    }
  }

  function startResendCooldown(seconds) {
    resendCountdown = seconds;
    var btn = document.getElementById('resend-btn');
    var timerText = document.getElementById('countdown-text');
    if (resendTimer) clearInterval(resendTimer);

    if (btn) btn.style.pointerEvents = 'none';
    if (btn) btn.style.opacity = '0.5';

    resendTimer = setInterval(function() {
      resendCountdown--;
      if (timerText) {
        timerText.textContent = resendCountdown > 0 ? 'Wait ' + resendCountdown + 's to resend' : '';
      }
      if (resendCountdown <= 0) {
        clearInterval(resendTimer);
        resendTimer = null;
        if (btn) {
          btn.style.pointerEvents = 'auto';
          btn.style.opacity = '1';
          btn.textContent = 'Resend code';
        }
      }
    }, 1000);
  }

  function goToStep1() {
    hideBanners();
    document.getElementById('step-2-card').classList.add('hidden');
    document.getElementById('step-1-card').classList.remove('hidden');
    var otpInput = document.getElementById('otp-code');
    if (otpInput) otpInput.value = '';
  }

  // Step 1: Submit email & password
  function handleLogin(e) {
    e.preventDefault();
    var btn = document.getElementById('submit-btn');
    var text = document.getElementById('btn-text');
    var arrow = document.getElementById('btn-arrow');
    var spinner = document.getElementById('btn-spinner');

    hideBanners();

    btn.disabled = true;
    text.textContent = 'Checking...';
    arrow.classList.add('hidden');
    spinner.classList.remove('hidden');

    var form = document.getElementById('login-form');
    var formData = new FormData(form);

    fetch('/api/auth/login', { method: 'POST', body: formData })
      .then(function(res) { return res.json(); })
      .then(function(data) {
        if (data.ok) {
          if (data.requires2FA) {
            // Transition to Step 2
            var emailVal = data.email || formData.get('email');
            document.getElementById('step-2-email').textContent = emailVal;
            document.getElementById('step-1-card').classList.add('hidden');
            document.getElementById('step-2-card').classList.remove('hidden');

            showInfo('Verification code sent to your email.');

            var otpInput = document.getElementById('otp-code');
            if (otpInput) {
              otpInput.value = '';
              setTimeout(function() { otpInput.focus(); }, 100);
            }
            startResendCooldown(30);

            // Reset step 1 button
            btn.disabled = false;
            text.textContent = 'Sign In';
            arrow.classList.remove('hidden');
            spinner.classList.add('hidden');
          } else {
            // Direct login (trusted device)
            window.location.href = data.redirect || '/app/chat';
          }
        } else {
          showError(data.error || 'Sign in failed. Please try again.');
          btn.disabled = false;
          text.textContent = 'Sign In';
          arrow.classList.remove('hidden');
          spinner.classList.add('hidden');
        }
      })
      .catch(function() {
        showError('Network error. Please check your connection.');
        btn.disabled = false;
        text.textContent = 'Sign In';
        arrow.classList.remove('hidden');
        spinner.classList.add('hidden');
      });
  }

  // Step 2: Submit 2FA verification OTP
  function handleVerify2FA(e) {
    e.preventDefault();
    var btn = document.getElementById('verify-btn');
    var text = document.getElementById('verify-text');
    var arrow = document.getElementById('verify-arrow');
    var spinner = document.getElementById('verify-spinner');
    var otpInput = document.getElementById('otp-code');
    var otp = otpInput ? otpInput.value.replace(/\s+/g, '').trim() : '';

    if (!otp) {
      showError('Please enter the verification code.');
      return;
    }

    hideBanners();

    btn.disabled = true;
    text.textContent = 'Verifying...';
    arrow.classList.add('hidden');
    spinner.classList.remove('hidden');

    fetch('/api/auth/verify-2fa', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ otp: otp })
    })
      .then(function(res) { return res.json(); })
      .then(function(data) {
        if (data.ok) {
          text.textContent = 'Success! Redirecting...';
          window.location.href = data.redirect || '/app/chat';
        } else {
          showError(data.error || 'Verification failed. Please try again.');
          btn.disabled = false;
          text.textContent = 'Verify & Sign In';
          arrow.classList.remove('hidden');
          spinner.classList.add('hidden');
        }
      })
      .catch(function() {
        showError('Network error. Please check your connection.');
        btn.disabled = false;
        text.textContent = 'Verify & Sign In';
        arrow.classList.remove('hidden');
        spinner.classList.add('hidden');
      });
  }

  // Step 2: Resend 2FA code
  function handleResendCode() {
    if (resendCountdown > 0) return;
    var btn = document.getElementById('resend-btn');
    var originalText = btn.textContent;
    btn.textContent = 'Sending...';

    hideBanners();

    fetch('/api/auth/resend-2fa', { method: 'POST' })
      .then(function(res) { return res.json(); })
      .then(function(data) {
        if (data.ok) {
          showInfo(data.message || 'A new verification code has been sent to your email.');
          startResendCooldown(30);
        } else {
          showError(data.error || 'Failed to resend verification code.');
          btn.textContent = originalText;
        }
      })
      .catch(function() {
        showError('Network error. Could not resend code.');
        btn.textContent = originalText;
      });
  }
</script>
