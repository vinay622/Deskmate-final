---
interface Props {
  id: string;
  name: string;
  category: string;
  uploadedByName: string;
  createdAt: string;
  expiryDate: string | null;
  status: "active" | "expiring" | "expired";
  description: string;
  fileType?: string | null;
  processingStatus?: string;
}

const { name, category, uploadedByName, createdAt, expiryDate, status, description, fileType, processingStatus } =
  Astro.props;

// Indexing state is the primary signal (lime = ready to answer)
const processingConfig: Record<string, { label: string; cls: string }> = {
  pending: { label: "Pending", cls: "chip-neutral" },
  processing: { label: "Processing", cls: "chip-amber" },
  ready: { label: "Indexed", cls: "chip-lime" },
  failed: { label: "Failed", cls: "chip-danger" },
};
const ps = processingConfig[processingStatus ?? "pending"] ?? processingConfig.pending;

// Expiry is only surfaced when it needs attention
const expiryChip =
  status === "expiring"
    ? { label: "Expiring soon", cls: "chip-amber" }
    : status === "expired"
      ? { label: "Expired", cls: "chip-danger" }
      : null;

function getFileLabel(ft: string | null | undefined): string {
  if (!ft) return "";
  if (ft === "application/pdf") return "PDF";
  if (ft.includes("wordprocessingml")) return "DOCX";
  if (ft === "text/plain") return "TXT";
  if (ft.startsWith("image/")) return "IMG";
  return "";
}
const fileLabel = getFileLabel(fileType);

const formattedDate = new Date(createdAt).toLocaleDateString("en-IN", {
  day: "numeric",
  month: "short",
  year: "numeric",
});
const formattedExpiry = expiryDate
  ? new Date(expiryDate).toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric" })
  : null;
---

<div class="app-card p-5 hover:border-[#d5d8dd] transition-colors">
  <div class="flex items-start gap-4">
    <!-- File glyph -->
    <div class="w-10 h-10 rounded-[12px] bg-[#f0f1f3] flex items-center justify-center shrink-0">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#6b6f76" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
    </div>

    <div class="flex-1 min-w-0">
      <div class="flex items-start justify-between gap-3">
        <h3 class="font-medium text-dark text-[15px] truncate leading-snug">{name}</h3>
        <div class="flex items-center gap-1 shrink-0 -mt-0.5 -mr-1">
          {processingStatus === "failed" && (
            <button
              data-action="reprocess-doc"
              title="Retry processing this document"
              class="p-1.5 rounded-lg text-[#c4c9cf] hover:text-green hover:bg-[#f0f6ee] transition-colors"
            >
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
            </button>
          )}
          <button
            data-action="delete-doc"
            title="Delete document"
            class="p-1.5 rounded-lg text-[#c4c9cf] hover:text-red-500 hover:bg-red-50 transition-colors"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
          </button>
        </div>
      </div>

      {description && <p class="text-sm text-[#6b6f76] mt-1 line-clamp-2 leading-relaxed">{description}</p>}

      <!-- Chips -->
      <div class="flex items-center gap-1.5 flex-wrap mt-3">
        <span class={`chip ${ps.cls}`}>{ps.label}</span>
        <span class="chip chip-neutral">{category}</span>
        {fileLabel && <span class="chip chip-neutral font-mono">{fileLabel}</span>}
        {expiryChip && <span class={`chip ${expiryChip.cls}`}>{expiryChip.label}</span>}
      </div>
    </div>
  </div>

  <div class="h-px bg-[#f0f1f3] my-4"></div>

  <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-[#9aa0a6]">
    <span>Added by {uploadedByName || "Admin"} · {formattedDate}</span>
    {formattedExpiry && <span>Expires {formattedExpiry}</span>}
  </div>
</div>
