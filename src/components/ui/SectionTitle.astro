---
const { sectionTitle, description } = Astro.props;
---

<div class="flex flex-col items-center gap-5 mb-12 sm:mb-16 sm:flex-row sm:items-end sm:justify-between">
  <h2 class="text-center sm:text-left text-3xl sm:text-4xl leading-tight max-w-md"><span class="greenhead">{sectionTitle}</span></h2>
  <p class="w-auto text-center sm:text-left sm:w-[530px] text-[#626671] leading-relaxed">
    {description}
  </p>
</div>
